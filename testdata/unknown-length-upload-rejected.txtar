tail-logs
create-pool

exec restic-rados-server --listen 127.0.0.1:$PORT --max-object-size 1000000 --write-buffer-size 262144 &server&
wait4socket 127.0.0.1:$PORT

exec curl --silent --request POST 'http://127.0.0.1:'$PORT'/?create=true'

bin-file rand blob 2500000
sha256 blob HASH

exec curl --http1.1 --silent --write-out '%{http_code}' --request POST --header 'Content-Type: application/octet-stream' --header 'Transfer-Encoding: chunked' --data-binary @blob 'http://127.0.0.1:'$PORT'/data/'$HASH --output response
stdout '411'
cmp response expected-response

exec rados --pool $RESTIC_RADOS_SERVER_POOL ls
! stdout 'data/'

bin-file rand config-body 4096

exec curl --http1.1 --silent --write-out '%{http_code}' --request POST --header 'Content-Type: application/octet-stream' --header 'Transfer-Encoding: chunked' --data-binary @config-body 'http://127.0.0.1:'$PORT'/config' --output /dev/null
stdout '200'

exec rados --pool $RESTIC_RADOS_SERVER_POOL ls
stdout 'config'

exec curl --silent 'http://127.0.0.1:'$PORT'/config' --output downloaded-config
bin-cmp downloaded-config config-body

bin-file rand lock-body 512
sha256 lock-body LOCKHASH

exec curl --http1.1 --silent --write-out '%{http_code}' --request POST --header 'Content-Type: application/octet-stream' --header 'Transfer-Encoding: chunked' --data-binary @lock-body 'http://127.0.0.1:'$PORT'/locks/'$LOCKHASH --output /dev/null
stdout '200'

exec curl --silent 'http://127.0.0.1:'$PORT'/locks/'$LOCKHASH --output downloaded-lock
bin-cmp downloaded-lock lock-body

exec curl --silent --write-out '%{http_code}' --request POST --header 'Content-Type: application/octet-stream' --data-binary @blob 'http://127.0.0.1:'$PORT'/data/'$HASH --output /dev/null
stdout '200'

exec rados --pool $RESTIC_RADOS_SERVER_POOL ls
stdout 'data/'$HASH'\.0000000000000000'
stdout 'data/'$HASH'\.0000000000000001'
stdout 'data/'$HASH'\.0000000000000002'

exec curl --silent 'http://127.0.0.1:'$PORT'/data/'$HASH --output downloaded-blob
bin-cmp downloaded-blob blob

kill server

exec restic-rados-server --listen $WORK/unstriped.sock --striper=false &unstriped&
wait4socket $WORK/unstriped.sock

bin-file rand plain-blob 500000
sha256 plain-blob PLAINHASH

exec curl --http1.1 --silent --write-out '%{http_code}' --unix-socket $WORK/unstriped.sock --request POST --header 'Content-Type: application/octet-stream' --header 'Transfer-Encoding: chunked' --data-binary @plain-blob 'http://localhost/data/'$PLAINHASH --output /dev/null
stdout '200'

exec rados --pool $RESTIC_RADOS_SERVER_POOL ls
stdout 'data/'$PLAINHASH'$'

exec curl --silent --unix-socket $WORK/unstriped.sock 'http://localhost/data/'$PLAINHASH --output downloaded-plain
bin-cmp downloaded-plain plain-blob

kill unstriped

-- expected-response --
content length required
