tail-logs
create-pool new
create-pool old

exec restic-rados-server --pool=$CEPH_POOL_OLD --max-object-size 1048576 --listen $WORK/old.sock &oldserver&
wait4socket $WORK/old.sock

exec curl --silent --unix-socket $WORK/old.sock --request POST 'http://localhost/?create=true'

bin-file rand blob 2621440
sha256 blob HASH

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/old.sock --request POST --data-binary @blob http://localhost/data/$HASH --output /dev/null
stdout '200'

exec rados --pool $CEPH_POOL_OLD ls
stdout 'data/'$HASH'\.0000000000000000'
stdout 'data/'$HASH'\.0000000000000002'

kill oldserver

envsubst config.json.tmpl config.json

exec restic-rados-server --config config.json --max-object-size 1048576 --listen $WORK/restic.sock &server&
wait4socket $WORK/restic.sock

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request POST --data-binary @blob http://localhost/data/$HASH --output /dev/null
stdout '403'

exec rados --pool $CEPH_POOL_NEW ls
! stdout 'data/'

exec curl --silent --unix-socket $WORK/restic.sock http://localhost/data/$HASH --output downloaded
bin-cmp downloaded blob

exec rados --pool $CEPH_POOL_OLD ls
stdout 'data/'$HASH'\.0000000000000000'
stdout 'data/'$HASH'\.0000000000000002'

kill server

-- config.json.tmpl --
{"repos":{"default":{"blob_pools":{"config":{"upper":{"pool":"$CEPH_POOL_NEW"},"lower":{"pool":"$CEPH_POOL_OLD"}},"keys":{"upper":{"pool":"$CEPH_POOL_NEW"},"lower":{"pool":"$CEPH_POOL_OLD"}},"locks":{"upper":{"pool":"$CEPH_POOL_NEW"},"lower":{"pool":"$CEPH_POOL_OLD"}},"snapshots":{"upper":{"pool":"$CEPH_POOL_NEW"},"lower":{"pool":"$CEPH_POOL_OLD"}},"index":{"upper":{"pool":"$CEPH_POOL_NEW"},"lower":{"pool":"$CEPH_POOL_OLD"}},"data":{"upper":{"pool":"$CEPH_POOL_NEW"},"lower":{"pool":"$CEPH_POOL_OLD"}}}}}}
