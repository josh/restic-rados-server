tail-logs
create-pool meta
create-pool data

envsubst canonical.json.tmpl canonical.json
envsubst literal-collision.json.tmpl literal-collision.json

exec restic-rados-server --config canonical.json --listen $WORK/canonical.sock &canonical&
wait4socket $WORK/canonical.sock
kill canonical

! grep 'repos may share storage' $RESTIC_RADOS_SERVER_LOG_FILE

exec restic-rados-server --config literal-collision.json --listen $WORK/literal.sock &literal&
wait4socket $WORK/literal.sock
kill literal

exec grep --count 'msg="repos may share storage"' $RESTIC_RADOS_SERVER_LOG_FILE
stdout '^1$'
grep 'msg="repos may share storage" repo=default other_repo=other blob_types=config,keys,locks,snapshots,data,index' $RESTIC_RADOS_SERVER_LOG_FILE

-- canonical.json.tmpl --
{
    "repos": {
        "default": {
            "pools": {
                "$CEPH_POOL_META": ["config", "keys", "locks", "snapshots"],
                "$CEPH_POOL_DATA": ["data", "index"]
            }
        },
        "*": {
            "pools": {
                "$CEPH_POOL_META/{repo}": ["config", "keys", "locks", "snapshots"],
                "$CEPH_POOL_DATA/{repo}": ["data", "index"]
            }
        }
    }
}
-- literal-collision.json.tmpl --
{
    "repos": {
        "default": {
            "pools": {
                "$CEPH_POOL_META/ns": ["*"]
            }
        },
        "other": {
            "pools": {
                "$CEPH_POOL_META/ns": ["*"]
            }
        }
    }
}
