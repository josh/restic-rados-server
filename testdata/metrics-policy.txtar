tail-logs
create-pool

envsubst config.json.tmpl config.json

exec restic-rados-server --config config.json &server&
wait4socket $WORK/caps.sock $WORK/policy.sock

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/caps.sock 'http://localhost/metrics' --output /dev/null
stdout '403'

exec curl --silent --write-out '%{http_code}' --header 'X-Restic-Capabilities: {"metrics":"r"}' --unix-socket $WORK/caps.sock 'http://localhost/metrics' --output /dev/null
stdout '200'

exec curl --silent --write-out '%{http_code}' --header 'X-Restic-Capabilities: {"*":"r"}' --unix-socket $WORK/caps.sock 'http://localhost/metrics' --output /dev/null
stdout '200'

exec curl --silent --write-out '%{http_code}' --header 'X-Restic-Capabilities: {"metrics":"none"}' --unix-socket $WORK/caps.sock 'http://localhost/metrics' --output /dev/null
stdout '403'

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/caps.sock 'http://localhost/healthz' --output /dev/null
stdout '200'

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/policy.sock 'http://localhost/metrics' --output /dev/null
stdout '200'

kill server

-- config.json.tmpl --
{
    "listen": [
        {"endpoint": "$WORK/caps.sock", "metrics": "/metrics", "trusted_app_caps_header": "X-Restic-Capabilities"},
        {"endpoint": "$WORK/policy.sock", "metrics": "/metrics", "policy": {"access": "r"}}
    ]
}
