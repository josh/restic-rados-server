tail-logs
create-pool shared

envsubst nested.json.tmpl nested.json
exec restic-rados-server --config nested.json --listen $WORK/restic.sock &server&
wait4socket $WORK/restic.sock
kill server

grep 'msg="repos may share storage" repo=nested other_repo=outer blob_types=data' $RESTIC_RADOS_SERVER_LOG_FILE

-- nested.json.tmpl --
{
    "repos": {
        "outer": {
            "blob_pools": {
                "config": {
                    "pool": "$CEPH_POOL_SHARED",
                    "namespace": "outer-config"
                },
                "data": {
                    "pool": "$CEPH_POOL_SHARED",
                    "namespace": "shared",
                    "prefix": ""
                }
            }
        },
        "nested": {
            "blob_pools": {
                "config": {
                    "pool": "$CEPH_POOL_SHARED",
                    "namespace": "nested-config"
                },
                "data": {
                    "pool": "$CEPH_POOL_SHARED",
                    "namespace": "shared",
                    "prefix": "data/"
                }
            }
        }
    }
}
