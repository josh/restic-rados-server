tail-logs
create-pool

env CEPH_ARGS=--osd-max-object-size=4194304
exec restic-rados-server --listen $WORK/restic.sock &server&
wait4socket $WORK/restic.sock

exec curl --silent --unix-socket $WORK/restic.sock --request POST 'http://localhost/?create=true'

bin-file zeros large-blob 10000000
sha256 large-blob HASH

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @large-blob http://localhost/data/$HASH --output /dev/null
stdout '200'

exec rados --pool $RESTIC_RADOS_SERVER_POOL ls
stdout 'data/'$HASH'\.0000000000000000'
stdout 'data/'$HASH'\.0000000000000002'

kill server

env RESTIC_RADOS_SERVER_LOG_FILE=
env CEPH_RESTIC_SERVER_LOG_FILE=
env CEPH_ARGS=--auth-client-required=cephx
! exec restic-rados-server
stderr 'invalid ceph configuration'
