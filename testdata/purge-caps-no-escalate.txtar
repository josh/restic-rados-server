tail-logs
create-pool

exec restic-rados-server --access ra --listen $WORK/open.sock --listen $WORK/trusted.sock?trusted-caps-header=X-Restic-Capabilities &server&
wait4socket $WORK/open.sock
wait4socket $WORK/trusted.sock

exec curl --silent --unix-socket $WORK/open.sock --request POST 'http://localhost/?create=true'
exec curl --silent --unix-socket $WORK/open.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @config-data http://localhost/config

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/open.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @blob-x 'http://localhost/data/b5bb9d8014a0f9b1d61e21e796d78dccdf1352f23cd32812f4850b878ae4944c' --output /dev/null
stdout '200'

exec curl --silent --write-out '%{http_code}' --header 'X-Restic-Capabilities: {"*":"rw"}' --unix-socket $WORK/trusted.sock --request DELETE 'http://localhost/?purge=true'
stdout 'access denied'
stdout '403'

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/open.sock --request DELETE 'http://localhost/?purge=true'
stdout 'access denied'
stdout '403'

! grep 'purged repository' $RESTIC_RADOS_SERVER_LOG_FILE

rados-object-count ''
cmp stdout two.txt

kill server

-- config-data --
{"version":2,"id":"test","chunker_polynomial":"25b468838dcb75ea"}
-- blob-x --
foo
-- two.txt --
2
