tail-logs
create-pool

bin-file rand plain.bin 1024
bin-file rand striped.bin 2048
sha256 plain.bin HASH

exec rados --pool $RESTIC_RADOS_SERVER_POOL --striper put data/$HASH striped.bin
exec rados --pool $RESTIC_RADOS_SERVER_POOL put data/$HASH plain.bin

rados-object-count data/
stdout '^2$'

exec restic-rados-server --listen $WORK/restic.sock &server&
wait4socket $WORK/restic.sock

exec curl --silent --unix-socket $WORK/restic.sock 'http://localhost/data/'$HASH --output downloaded.bin
bin-cmp downloaded.bin plain.bin

exec curl --silent --unix-socket $WORK/restic.sock 'http://localhost/data/' --output list-v1.json
exec jq '[.[] | select(. == "'$HASH'")] | length' list-v1.json
stdout '^2$'

exec curl --silent --unix-socket $WORK/restic.sock --header 'Accept: application/vnd.x.restic.rest.v2' 'http://localhost/data/' --output list-v2.json
exec jq '[.[] | select(.name == "'$HASH'")] | length' list-v2.json
stdout '^2$'
exec jq -r '.[] | select(.name == "'$HASH'") | .size' list-v2.json
stdout '^1024$'

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request DELETE 'http://localhost/data/'$HASH --output /dev/null
stdout '^200$'

rados-object-count data/
stdout '^1$'

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock 'http://localhost/data/'$HASH --output downloaded-after-delete.bin
stdout '^200$'
bin-cmp downloaded-after-delete.bin striped.bin

kill server
