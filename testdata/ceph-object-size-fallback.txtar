tail-logs
create-pool

cp $CEPH_CONF zero.conf
exec sed --in-place 's/^osd_max_object_size = .*/osd_max_object_size = 0/' zero.conf

exec restic-rados-server --ceph-conf zero.conf --listen $WORK/restic.sock &server&
wait4socket $WORK/restic.sock

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock 'http://localhost/readyz' --output /dev/null
stdout '200'

kill server
