tail-logs
create-pool shared replicated

env LISTEN_ENDPOINT=$WORK/cli.sock
envsubst config.json.tmpl config.json

exec restic-rados-server --config config.json --access ra &cli&
wait4socket $WORK/cli.sock

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/cli.sock 'http://localhost/' --output /dev/null
stdout '404'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/cli.sock --request POST 'http://localhost/named/?create=true' --output /dev/null
stdout '200'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/cli.sock --request POST --data-binary @blob-data 'http://localhost/named/data/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '200'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/cli.sock --request POST --data-binary @blob-data 'http://localhost/named/keys/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '200'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/cli.sock --request POST --data-binary @blob-data 'http://localhost/named/snapshots/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '200'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/cli.sock --request DELETE 'http://localhost/named/data/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '403'

kill cli

env RESTIC_RADOS_SERVER_ACCESS=ra
env LISTEN_ENDPOINT=$WORK/env.sock
envsubst config.json.tmpl config.json
exec restic-rados-server --config config.json &envserver&
wait4socket $WORK/env.sock

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/env.sock 'http://localhost/' --output /dev/null
stdout '404'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/env.sock --request POST 'http://localhost/dynamic/?create=true' --output /dev/null
stdout '200'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/env.sock --request POST --data-binary @blob-data 'http://localhost/dynamic/data/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '200'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/env.sock --request DELETE 'http://localhost/dynamic/data/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '403'

kill envserver

env RESTIC_RADOS_SERVER_ACCESS=
env LISTEN_ENDPOINT=$WORK/canonical-json.sock
envsubst canonical-access.json.tmpl canonical-access.json
exec restic-rados-server --config canonical-access.json &canonicaljson&
wait4socket $WORK/canonical-json.sock
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/canonical-json.sock --request DELETE 'http://localhost/named/data/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '403'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/canonical-json.sock --request DELETE 'http://localhost/dynamic/data/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '403'
kill canonicaljson

env RESTIC_RADOS_SERVER_ACCESS=rw
env LISTEN_ENDPOINT=$WORK/restrictive.sock
envsubst restrictive-repos.json.tmpl restrictive-repos.json
exec restic-rados-server --config restrictive-repos.json --access rw &restrictive&
wait4socket $WORK/restrictive.sock
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restrictive.sock --request POST --data-binary @blob-data 'http://localhost/named/index/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '200'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restrictive.sock --request DELETE 'http://localhost/named/index/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '403'
exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restrictive.sock --request POST --data-binary @blob-data 'http://localhost/dynamic/index/abd9a2bf47af3416b041796843b9f9a7a5e987356da7ccfc750816219f0a075a' --output /dev/null
stdout '403'
kill restrictive

env RESTIC_RADOS_SERVER_ACCESS=

-- config.json.tmpl --
{
    "listen": [{"endpoint": "$LISTEN_ENDPOINT", "policy": {"access": "rw"}}],
    "repos": {
        "named": {"pools": {"$CEPH_POOL_SHARED/named": ["*"]}, "access": "rw"},
        "*": {"pools": {"$CEPH_POOL_SHARED/wildcard-{repo}": ["*"]}, "access": "rw"}
    }
}
-- blob-data --
test blob content
-- canonical-access.json.tmpl --
{
    "listen": [{"endpoint": "$LISTEN_ENDPOINT", "policy": {"access": "rw"}}],
    "access": "ra",
    "repos": {
        "named": {"pools": {"$CEPH_POOL_SHARED/named": ["*"]}, "access": "rw"},
        "*": {"pools": {"$CEPH_POOL_SHARED/wildcard-{repo}": ["*"]}, "access": "rw"}
    }
}
-- restrictive-repos.json.tmpl --
{
    "listen": [{"endpoint": "$LISTEN_ENDPOINT", "policy": {"access": "rw"}}],
    "access": "r",
    "repos": {
        "named": {"pools": {"$CEPH_POOL_SHARED/named": ["*"]}, "access": "ra"},
        "*": {"pools": {"$CEPH_POOL_SHARED/wildcard-{repo}": ["*"]}, "access": "r"}
    }
}
