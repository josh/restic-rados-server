kill server

-- config.json.tmpl --
{
    "repos": {
        "default": {"pools": {"$CEPH_POOL_SHARED/default": ["*"]}, "access": "rw"},
        "named": {"pools": {"$CEPH_POOL_SHARED/named": ["*"]}, "access": "rw"},
        "*": {"pools": {"$CEPH_POOL_SHARED/wildcard-{repo}": ["*"]}, "access": "rw"}
    }
}
-- config-data --
{"version":2,"id":"test","chunker_polynomial":"25b468838dcb75ea"}
-- blob-data --
test blob content
