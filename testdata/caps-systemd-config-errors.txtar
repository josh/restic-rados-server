tail-logs
create-pool

! exec restic-rados-server --config unmatched.json
grep 'no matching inherited socket' $RESTIC_RADOS_SERVER_LOG_FILE

! exec restic-rados-server --config dup.json
grep 'duplicate.*systemd:web' $RESTIC_RADOS_SERVER_LOG_FILE

-- unmatched.json --
{
    "listen": [{"endpoint": "systemd:restic", "trusted_app_caps_header": "X-Restic-Capabilities"}]
}
-- dup.json --
{
    "listen": [
        {"endpoint": "systemd:web", "trusted_app_caps_header": "X-Restic-Capabilities"},
        {"endpoint": "systemd:web", "trusted_app_caps_header": "X-Company-Auth"}
    ]
}
