tail-logs
create-pool

envsubst config.json.tmpl config.json

exec restic-rados-server --config config.json &server&
wait4socket $WORK/restic.sock

exec curl --silent --write-out '%{http_code}' --header 'Tailscale-App-Capabilities: {"github.com/josh/restic-rados-server":[{"*":"rw"}]}' --unix-socket $WORK/restic.sock --request POST 'http://localhost/?create=true' --output /dev/null
stdout '200'

exec curl --silent --write-out '%{http_code}' --header 'Tailscale-App-Capabilities: {"github.com/josh/restic-rados-server":[{"*":"rw"}]}' --unix-socket $WORK/restic.sock --request POST --data-binary @config-data 'http://localhost/config' --output /dev/null
stdout '200'

exec curl --silent --write-out '%{http_code}' --header 'Tailscale-App-Capabilities: {"github.com/josh/restic-rados-server":[{"*":"rw"}]}' --unix-socket $WORK/restic.sock --request POST --data-binary @blob-x 'http://localhost/data/b5bb9d8014a0f9b1d61e21e796d78dccdf1352f23cd32812f4850b878ae4944c' --output /dev/null
stdout '200'

exec curl --silent --write-out '%{http_code}' --header 'Tailscale-App-Capabilities: {"github.com/josh/restic-rados-server":[{"*":"r"}]}' --unix-socket $WORK/restic.sock --request DELETE 'http://localhost/?purge=true'
stdout 'access denied'
stdout '403'

exec curl --silent --write-out '%{http_code}' --header 'Tailscale-App-Capabilities: {"github.com/josh/restic-rados-server":[{"*":"ra"}]}' --unix-socket $WORK/restic.sock --request DELETE 'http://localhost/?purge=true'
stdout 'access denied'
stdout '403'

rados-object-count ''
cmp stdout two.txt

exec curl --silent --write-out '%{http_code}' --header 'Tailscale-App-Capabilities: {"github.com/josh/restic-rados-server":[{"*":"rw"}]}' --unix-socket $WORK/restic.sock --request DELETE 'http://localhost/?purge=true' --output /dev/null
stdout '200'

rados-object-count ''
cmp stdout zero.txt

kill server

-- config.json.tmpl --
{
    "listen": [{"endpoint": "$WORK/restic.sock", "options": {"accept_app_caps": ["github.com/josh/restic-rados-server"]}}]
}
-- config-data --
{"version":2,"id":"test","chunker_polynomial":"25b468838dcb75ea"}
-- blob-x --
foo
-- two.txt --
2
-- zero.txt --
0
