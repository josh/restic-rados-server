tail-logs
create-pool

envsubst config.json.tmpl config.json

! exec restic-rados-server --config config.json
grep 'cannot reach tailscaled' $RESTIC_RADOS_SERVER_LOG_FILE

-- config.json.tmpl --
{
    "listen": [{"endpoint": "tailscale+svc:restic", "options": {"accept_app_caps": ["github.com/josh/restic-rados-server"], "socket": "$WORK/missing/tailscaled.sock"}}]
}
