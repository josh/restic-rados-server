tail-logs
create-pool

exec restic init --option rclone.program=restic-rados-server --repo rclone: --password-file password.txt

mkdir files
bin-file rand files/file0.bin 16384
bin-file rand files/file1.bin 16384
bin-file rand files/file2.bin 16384
bin-file rand files/file3.bin 16384
bin-file rand files/file4.bin 16384
bin-file rand files/file5.bin 16384
bin-file rand files/file6.bin 16384
bin-file rand files/file7.bin 16384
bin-file rand files/file8.bin 16384
bin-file rand files/file9.bin 16384
bin-file rand files/file10.bin 16384
bin-file rand files/file11.bin 16384
bin-file rand files/file12.bin 16384
bin-file rand files/file13.bin 16384
bin-file rand files/file14.bin 16384
bin-file rand files/file15.bin 16384
bin-file rand files/file16.bin 16384
bin-file rand files/file17.bin 16384
bin-file rand files/file18.bin 16384
bin-file rand files/file19.bin 16384
bin-file rand files/file20.bin 16384
bin-file rand files/file21.bin 16384
bin-file rand files/file22.bin 16384
bin-file rand files/file23.bin 16384
bin-file rand files/file24.bin 16384
bin-file rand files/file25.bin 16384
bin-file rand files/file26.bin 16384
bin-file rand files/file27.bin 16384
bin-file rand files/file28.bin 16384
bin-file rand files/file29.bin 16384
bin-file rand files/file30.bin 16384
bin-file rand files/file31.bin 16384

exec restic backup files --option rclone.program=restic-rados-server --repo rclone: --password-file password.txt

exec restic list blobs --option rclone.program=restic-rados-server --repo rclone: --password-file password.txt

stdin stdout
exec awk '$1 == "data" { count++; if (count == 2) { print $2; exit } }'
capture-output BLOB_ID

exec restic cat blob $BLOB_ID --option rclone.program=restic-rados-server --repo rclone: --password-file password.txt
stdin stdout
exec wc --bytes

cmp stdout size.txt

-- password.txt --
secret
-- size.txt --
16384
