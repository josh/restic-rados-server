! exec restic-rados-server --config config.json --listen $WORK/restic.sock
stderr 'failed to load config file'

! exec restic-rados-server --config flat-pools.json
stderr 'failed to load config file'

! exec restic-rados-server --config flat-access.json
stderr 'pool not set'

! exec restic-rados-server --config flat-striper.json
stderr 'failed to load config file'

! exec restic-rados-server --config flat-max-object-size.json
stderr 'failed to load config file'

! exec restic-rados-server --config bad-duration.json
stderr 'failed to load config file'

! exec restic-rados-server --config global-access-null.json
stderr 'access cannot be null'

! exec restic-rados-server --config repo-access-null.json
stderr 'access cannot be null'

! exec restic-rados-server --config global-access-none.json
stderr 'invalid access "none"'

! exec restic-rados-server --config repo-access-none.json
stderr 'invalid access "none"'

! exec restic-rados-server --config listener-access-none.json
stderr 'invalid.*access.*none'

! exec restic-rados-server --config global-access-empty.json
stderr 'invalid access ""'

! exec restic-rados-server --config trailing-json.json
stderr 'unexpected data after JSON object'

! exec restic-rados-server --config listener-access-null.json
stderr 'access.*null'

! exec restic-rados-server --config listener-access-empty.json
stderr 'invalid.*access'

! exec restic-rados-server --config listener-trust-empty.json
stderr 'trusted_app_caps_header.*empty'

! exec restic-rados-server --config listener-trust-null.json
stderr 'accept_app_caps.*null'

! exec restic-rados-server --access=none
stderr 'invalid access "none"'

! exec restic-rados-server --access=
stderr 'invalid access ""'

-- config.json --
{
    "verbose": true,
    "typo_field": "bad"
}
-- flat-pools.json --
{
    "pools": {"my-pool": ["*"]}
}
-- flat-access.json --
{
    "access": "ra"
}
-- flat-striper.json --
{
    "striper": false
}
-- flat-max-object-size.json --
{
    "max_object_size": 4096
}
-- bad-duration.json --
{
    "shutdown_timeout": "banana"
}
-- global-access-null.json --
{
    "Access": null
}
-- repo-access-null.json --
{
    "repos": {"default": {"Access": null}}
}
-- global-access-none.json --
{
    "access": "none"
}
-- repo-access-none.json --
{
    "repos": {"default": {"access": "none"}}
}
-- listener-access-none.json --
{
    "listen": [{"endpoint": "/tmp/restic.sock", "policy": {"access": "none"}}]
}
-- global-access-empty.json --
{
    "access": ""
}
-- trailing-json.json --
{} {}
-- listener-access-null.json --
{
    "listen": [{"endpoint": "/tmp/restic.sock", "policy": {"access": null}}]
}
-- listener-access-empty.json --
{
    "listen": [{"endpoint": "/tmp/restic.sock", "policy": {"access": ""}}]
}
-- listener-trust-empty.json --
{
    "listen": [{"endpoint": "/tmp/restic.sock", "trusted_app_caps_header": ""}]
}
-- listener-trust-null.json --
{
    "listen": [{"endpoint": "/tmp/restic.sock", "options": {"accept_app_caps": null}}]
}
