tail-logs
create-pool

exec bash make-client-config $CEPH_CONF client.conf
env CEPH_CONF=$WORK/client.conf
env CEPH_ID=unreachable
env CEPH_KEYRING=$WORK/direct.keyring
! exec restic-rados-server --stdio
grep 'initial ceph connection failed' $RESTIC_RADOS_SERVER_LOG_FILE
grep 'connection unavailable' $RESTIC_RADOS_SERVER_LOG_FILE

env CEPH_ID=
exec restic-rados-server --listen $WORK/restic.sock &server&
wait4socket $WORK/restic.sock
exec curl --silent --unix-socket $WORK/restic.sock --request POST 'http://localhost/?create=true'
kill server

-- make-client-config --
#!/bin/sh
set -o errexit
set -o pipefail
cp "$1" "$2"
printf '\n[client.unreachable]\nmon_host = 127.0.0.1:1\n' >> "$2"

-- direct.keyring --
[client.unreachable]
	key = AQDummyKeyForTestingOnly==
