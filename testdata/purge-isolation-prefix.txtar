tail-logs
create-pool shared

envsubst config.json.tmpl config.json

exec restic-rados-server --config config.json --listen $WORK/restic.sock &server&
wait4socket $WORK/restic.sock

exec curl --silent --unix-socket $WORK/restic.sock --request POST 'http://localhost/repoa/?create=true'
exec curl --silent --unix-socket $WORK/restic.sock --request POST 'http://localhost/repoab/?create=true'

exec curl --silent --unix-socket $WORK/restic.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @config-data http://localhost/repoa/config
exec curl --silent --unix-socket $WORK/restic.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @config-data http://localhost/repoab/config

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @blob-x 'http://localhost/repoa/data/b5bb9d8014a0f9b1d61e21e796d78dccdf1352f23cd32812f4850b878ae4944c' --output /dev/null
stdout '200'

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @blob-z 'http://localhost/repoab/data/f2ca1bb6c7e907d06dafe4687e579fce76b37e4e93b7605022da52e6ccc26fd2' --output /dev/null
stdout '200'

exec rados --pool $CEPH_POOL_SHARED --namespace shared ls
stdout '^a/config$'
stdout '^ab/config$'

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request DELETE 'http://localhost/repoa/?purge=true' --output /dev/null
stdout '200'

exec rados --pool $CEPH_POOL_SHARED --namespace shared ls
! stdout '^a/'
stdout '^ab/config$'
stdout '^ab/data/f2ca1bb6c7e907d06dafe4687e579fce76b37e4e93b7605022da52e6ccc26fd2$'

exec curl --silent --unix-socket $WORK/restic.sock 'http://localhost/repoab/data/f2ca1bb6c7e907d06dafe4687e579fce76b37e4e93b7605022da52e6ccc26fd2'
cmp stdout blob-z

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request DELETE 'http://localhost/repoab/?purge=true' --output /dev/null
stdout '200'

exec rados --pool $CEPH_POOL_SHARED --namespace shared ls
! stdout '.'

kill server

-- config.json.tmpl --
{
    "repos": {
        "repoa": {
            "blob_pools": {
                "config": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "a/"},
                "keys": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "a/"},
                "locks": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "a/"},
                "snapshots": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "a/"},
                "data": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "a/"},
                "index": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "a/"}
            }
        },
        "repoab": {
            "blob_pools": {
                "config": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "ab/"},
                "keys": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "ab/"},
                "locks": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "ab/"},
                "snapshots": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "ab/"},
                "data": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "ab/"},
                "index": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "ab/"}
            }
        }
    }
}
-- config-data --
{"version":2,"id":"test","chunker_polynomial":"25b468838dcb75ea"}
-- blob-x --
foo
-- blob-z --
test
