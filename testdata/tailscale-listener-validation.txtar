tail-logs
create-pool

! exec restic-rados-server --listen tailscale+svc:
stderr 'missing Tailscale service name'

! exec restic-rados-server --listen tailscale+svc:foo/bar
stderr 'DNS label'

! exec restic-rados-server --listen 'tailscale+svc:foo bar'
stderr 'DNS label'

! exec restic-rados-server --listen tailscale+svc:backup_repo
stderr 'DNS label'

! exec restic-rados-server --listen tailscale+svc:restic?tscaps=github.com/josh/restic-rados-server
stderr 'query parameters.*not supported'

! exec restic-rados-server --config trusted-header.json
stderr 'trusted_app_caps_header.*not supported for tailscale'

! exec restic-rados-server --config badport.json
stderr 'options.port.*between'

envsubst collision.json.tmpl collision.json
! exec restic-rados-server --config collision.json
grep 'cannot be shared' $RESTIC_RADOS_SERVER_LOG_FILE

envsubst toolong.json.tmpl toolong.json
! exec restic-rados-server --config toolong.json
grep 'too long' $RESTIC_RADOS_SERVER_LOG_FILE
! exists $WORK/unexpected

-- trusted-header.json --
{
    "listen": [{"endpoint": "tailscale+svc:restic", "trusted_app_caps_header": "X-Restic-Capabilities"}]
}
-- badport.json --
{
    "listen": [{"endpoint": "tailscale+svc:restic", "options": {"port": 70000}}]
}
-- collision.json.tmpl --
{
    "listen": [
        {"endpoint": "tailscale+svc:a", "options": {"upstream_socket": "$WORK/shared.sock"}},
        {"endpoint": "tailscale+svc:b", "options": {"upstream_socket": "$WORK/shared.sock"}}
    ]
}
-- toolong.json.tmpl --
{
    "listen": [{"endpoint": "tailscale+svc:restic", "options": {"upstream_socket": "$WORK/unexpected/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.sock"}}]
}
