tail-logs
create-pool shared

envsubst config.json.tmpl config.json

exec restic-rados-server --config config.json --listen $WORK/restic.sock &server&
wait4socket $WORK/restic.sock

exec curl --silent --unix-socket $WORK/restic.sock --request POST 'http://localhost/repoa/?create=true'
exec curl --silent --unix-socket $WORK/restic.sock --request POST 'http://localhost/repob/?create=true'

exec curl --silent --unix-socket $WORK/restic.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @config-data http://localhost/repoa/config
exec curl --silent --unix-socket $WORK/restic.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @config-data http://localhost/repob/config

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @blob-x 'http://localhost/repoa/data/b5bb9d8014a0f9b1d61e21e796d78dccdf1352f23cd32812f4850b878ae4944c' --output /dev/null
stdout '200'

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request POST --header 'Content-Type: application/octet-stream' --data-binary @blob-z 'http://localhost/repob/data/f2ca1bb6c7e907d06dafe4687e579fce76b37e4e93b7605022da52e6ccc26fd2' --output /dev/null
stdout '200'

exec rados --pool $CEPH_POOL_SHARED --namespace shared ls
stdout '^config$'
stdout '^b/config$'

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request DELETE 'http://localhost/repoa/?purge=true' --output /dev/null
stdout '200'

exec rados --pool $CEPH_POOL_SHARED --namespace shared ls
! stdout '^config$'
! stdout '^data/'
stdout '^b/config$'
stdout '^b/data/f2ca1bb6c7e907d06dafe4687e579fce76b37e4e93b7605022da52e6ccc26fd2$'

exec curl --silent --unix-socket $WORK/restic.sock 'http://localhost/repob/data/f2ca1bb6c7e907d06dafe4687e579fce76b37e4e93b7605022da52e6ccc26fd2'
cmp stdout blob-z

exec curl --silent --write-out '%{http_code}' --unix-socket $WORK/restic.sock --request DELETE 'http://localhost/repob/?purge=true' --output /dev/null
stdout '200'

exec rados --pool $CEPH_POOL_SHARED --namespace shared ls
! stdout '.'

kill server

-- config.json.tmpl --
{
    "repos": {
        "repoa": {
            "blob_pools": {
                "config": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared"},
                "keys": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared"},
                "locks": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared"},
                "snapshots": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared"},
                "data": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared"},
                "index": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared"}
            }
        },
        "repob": {
            "blob_pools": {
                "config": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "b/"},
                "keys": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "b/"},
                "locks": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "b/"},
                "snapshots": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "b/"},
                "data": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "b/"},
                "index": {"pool": "$CEPH_POOL_SHARED", "namespace": "shared", "prefix": "b/"}
            }
        }
    }
}
-- config-data --
{"version":2,"id":"test","chunker_polynomial":"25b468838dcb75ea"}
-- blob-x --
foo
-- blob-z --
test
